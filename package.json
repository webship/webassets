{
  "name": "webassets",
  "private": true,
  "description": "Manage local and remote media assets. Have needed configurations on top of media management and media library.",
  "license": "GPL-2.0",
  "engines": {
    "yarn": ">= 4.18.1",
    "node": ">= 24.0"
  },
  "keywords": [
    "Drupal",
    "Web Assets",
    "Assets",
    "Webship"
  ],
  "author": "Webship.co",
  "scripts": {
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:js": "node ./node_modules/eslint/bin/eslint.js --cache --cache-location .eslintcache .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:yaml": "node ./node_modules/eslint/bin/eslint.js --cache --cache-location .eslintcache --ext .yml .",
    "test": "node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:headed": "HEADLESS=false node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js"
  },
  "dependencies": {},
  "devDependencies": {
    "webship-js": "^2.0.0",
    "eslint": "^8.0.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.0.0",
    "eslint-plugin-import": "^2.0.0",
    "eslint-plugin-jquery": "^1.0.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-yml": "^1.0.0",
    "glob": "^8.0.0",
    "loadjs": "^4.0.0",
    "minimist": "^1.0.0",
    "mkdirp": "^1.0.0",
    "normalize.css": "^8.0.0",
    "postcss": "^8.0.0",
    "postcss-header": "^3.0.0",
    "postcss-import": "^15.0.0",
    "postcss-preset-env": "^8.0.0",
    "postcss-pxtorem": "^6.0.0",
    "postcss-url": "^10.0.0",
    "prettier": "^2.0.0",
    "shepherd.js": "^10.0.0",
    "sortablejs": "^1.0.0",
    "stylelint": "^15.0.0",
    "stylelint-checkstyle-formatter": "^0.1.2",
    "stylelint-config-standard": "^33.0.0",
    "stylelint-order": "^6.0.0",
    "tabbable": "^6.0.0",
    "terser": "^5.0.0",
    "terser-webpack-plugin": "^5.0.0",
    "underscore": "^1.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "resolutions": {
    "@cucumber/cucumber": "10.0.1"
  },
  "browserslist": [
    "last 2 Chrome major versions",
    "last 2 Firefox major versions",
    "last 2 Safari major versions",
    "last 2 Edge major versions",
    "last 2 Opera versions",
    "last 2 iOS major versions",
    "last 1 ChromeAndroid version",
    "last 1 Samsung version",
    "Firefox ESR"
  ],
  "packageManager": "yarn@4.18.1"
}
